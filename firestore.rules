rules_version = '2';
// 島嶼微光 Kinmen Light Memorial Garden — Firestore 安全規則
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // 用登錄碼、Google、電子郵件登入的人（訪客的匿名身分不算）
    function isReal() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function isAdmin() { return isReal() && exists(/databases/$(database)/documents/admins/$(me())); }
    function memDoc(mid) { return get(/databases/$(database)/documents/memorials/$(mid)); }
    function isOwner(mid) { return signedIn() && memDoc(mid).data.owner == me(); }
    function isFam(mid) { return signedIn() && exists(/databases/$(database)/documents/memorials/$(mid)/members/$(me())); }
    // 台灣時間的「第幾天」
    function today() { return math.floor((request.time.toMillis() + 28800000) / 86400000); }
    function str(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function content(d) {
      return str(d, 'kind', 10) && str(d, 'name', 40) && str(d, 'relation', 30) && str(d, 'born', 20) && str(d, 'died', 20)
        && str(d, 'memory', 2000) && str(d, 'quote', 200) && str(d, 'avatar', 40) && str(d, 'photo', 900000);
    }
    function okMem(d) {
      return d.owner == me()
        && d.visibility in ['public', 'private']
        && d.pos is list && d.pos.size() == 2 && d.pos[0] is number && d.pos[1] is number
        && d.color is int && d.gen is number && d.ts is number
        && d.created is string && d.created.size() <= 12
        && content(d)
        // 不公開的紀念：名字和內容只能放在 private/main
        && (d.visibility == 'public' || !('name' in d));
    }
    function tPath(mid) { return path('/databases/' + database + '/documents/memorials/' + mid + '/' + request.resource.data.t.last); }

    // 一顆水晶一筆：文件編號＝水晶的位置
    match /memorials/{mid} {
      allow read: if true;
      allow create: if isReal()
        && mid.matches('^(SL-[0-9]{2}|MI[1-4]-[0-9]{3}|ME-[0-9A-Z]{4,12}-[0-9A-Z]{1,3})$')
        && okMem(request.resource.data) && request.resource.data.hidden == false;
      allow update: if
        // 點亮的人修改自己的紀念
        (isReal() && resource.data.owner == me() && okMem(request.resource.data)
          && request.resource.data.hidden == resource.data.hidden
          && request.resource.data.gen == resource.data.gen)
        // 管理員只能改「隱藏」
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']))
        // 任何人獻花、送禮、問候、寫公開信時更新統計：必須同時新增一筆自己的花／禮物／信
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t'])
            && request.resource.data.t.last is string
            && request.resource.data.t.last.matches('(tributes|letters)/' + me() + '_[0-9a-z_]+')
            && !exists(tPath(mid)) && existsAfter(tPath(mid)));
      allow delete: if signedIn() && (resource.data.owner == me() || isAdmin());

      // 不公開紀念的內容：點亮的人、家人、管理員
      match /private/{doc} {
        allow read: if signedIn() && (memDoc(mid).data.owner == me() || isFam(mid) || isAdmin());
        allow create, update: if isReal() && doc == 'main'
          && getAfter(/databases/$(database)/documents/memorials/$(mid)).data.owner == me()
          && request.resource.data.owner == me() && content(request.resource.data);
        allow delete: if signedIn() && (memDoc(mid).data.owner == me() || isAdmin());
      }

      // 家人：拿到家人碼的人
      match /members/{u} {
        allow read: if signedIn() && (u == me() || isOwner(mid));
        allow create: if isReal() && u == me() && request.resource.data.uid == me()
          && request.resource.data.code is string
          && get(/databases/$(database)/documents/familyCodes/$(request.resource.data.code)).data.mem == mid;
        allow delete: if signedIn() && (u == me() || isOwner(mid));
      }

      // 信：所有人／家人／只有自己；寫信的人可以改、可以收回
      match /letters/{lid} {
        function okL(d) {
          return d.author == me() && d.vis in ['all', 'family', 'me']
            && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
            && str(d, 'from', 30) && str(d, 'prompt', 60);
        }
        allow read: if resource.data.vis == 'all'
          || (signedIn() && (resource.data.author == me()
              || (resource.data.vis == 'family' && (isFam(mid) || isOwner(mid) || isAdmin()))));
        allow create: if isReal() && lid.matches(me() + '_[0-9]+') && okL(request.resource.data)
          && (memDoc(mid).data.visibility == 'public' || isOwner(mid) || isFam(mid));
        allow update: if isReal() && resource.data.author == me() && okL(request.resource.data)
          && request.resource.data.gen == resource.data.gen;
        allow delete: if signedIn() && (resource.data.author == me() || isOwner(mid) || isAdmin());
      }

      // 花・禮物・問候：每人每顆水晶每天各一次（文件編號＝人_種類_日）
      match /tributes/{tid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == me()
          && request.resource.data.kind in ['flower', 'gift', 'heart']
          && request.resource.data.d is int
          && request.resource.data.d >= today() - 1 && request.resource.data.d <= today() + 1
          && tid == me() + '_' + request.resource.data.kind + '_' + string(request.resource.data.d)
          && str(request.resource.data, 'k', 12);
        allow update: if false;
        allow delete: if signedIn() && (isOwner(mid) || isAdmin());
      }
    }

    match /familyCodes/{code} {
      allow get: if isReal();
      allow list: if false;
      allow create: if isReal() && code.matches('^FM-[0-9A-Z]{4}-[0-9A-Z]{4}$')
        && request.resource.data.owner == me()
        && get(/databases/$(database)/documents/memorials/$(request.resource.data.mem)).data.owner == me();
      allow delete: if signedIn() && resource.data.owner == me();
    }

    // 自己的登錄碼、家人碼清單、來訪紀錄（管理員可以讀，用來算統計人數）
    match /users/{u} {
      allow read: if signedIn() && (u == me() || isAdmin());
      allow write: if signedIn() && u == me();
    }

    // 管理員名單：只能在 Firebase 主控台手動新增
    match /admins/{u} {
      allow get: if signedIn() && u == me();
      allow list, write: if false;
    }
  }
}
